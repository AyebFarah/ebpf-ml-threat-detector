# Exported CSV files are large and rebuildable. Manifests stay tracked (small provenance)
/datasets/exports/*
!/datasets/exports/.gitkeep

# Experiment output: reports, figures, run logs
/experiments/reports/*
!/experiments/reports/.gitkeep
/experiments/runs/*
!/experiments/runs/.gitkeep

# Test and coverage output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Generated graph tensors and indexes; keep JSON provenance manifests
/datasets/graphs/*.pt
/datasets/graphs/*.csv

# Experiment logs and replay alerts
/experiments/logs/*
!/experiments/logs/.gitkeep

# Generated database summary
/observation/database/reports/run_summary.txt

